cabal-version:      3.0
name:               kpbj-storage
version:            0.1.0
license:            Apache-2.0
author:             Solomon Bothwell
maintainer:         ssbothwell@gmail.com
build-type:         Simple

--------------------------------------------------------------------------------

common common-extensions
  default-extensions:
      DataKinds
      DerivingStrategies
      DeriveAnyClass
      DerivingVia
      DeriveGeneric
      FlexibleContexts
      FlexibleInstances
      GADTs
      GeneralizedNewtypeDeriving
      ImportQualifiedPost
      InstanceSigs
      LambdaCase
      MultiParamTypeClasses
      OverloadedRecordDot
      OverloadedStrings
      RankNTypes
      RecordWildCards
      StrictData
      TypeApplications
      TypeOperators
      TypeSynonymInstances

--------------------------------------------------------------------------------

library
  import: common-extensions
  build-depends:
      amazonka
    , amazonka-s3
    , base
    , bytestring
    , directory
    , filepath
    , kpbj-types
    , lens
    , resourcet
    , text
    , web-server-core
  exposed-modules:
    Effects.AWS
    Effects.Storage
    Effects.Storage.Config
    Effects.Storage.Local
    Effects.Storage.S3
    Effects.Storage.Staging
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Werror -fwrite-ide-info

--------------------------------------------------------------------------------

test-suite kpbj-storage-test
  import: common-extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Effects.Storage.ConfigSpec
    Effects.Storage.LocalSpec
    Effects.Storage.StagingSpec
  build-depends:
      base
    , directory
    , filepath
    , hspec
    , kpbj-storage
    , kpbj-types
    , temporary
    , text
    , web-server-core
  build-tool-depends:
      hspec-discover:hspec-discover
  default-language: Haskell2010
  ghc-options: -Wall -Werror -threaded -fwrite-ide-info
