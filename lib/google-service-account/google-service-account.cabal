cabal-version:      3.0
name:               google-service-account
version:            0.1.0.0
synopsis:           OAuth2 access tokens for a Google service account
license:            BSD-3-Clause
author:             Solomon Bothwell
maintainer:         ssbothwell@gmail.com
build-type:         Simple

--------------------------------------------------------------------------------

common common-extensions
  default-extensions:
      DerivingStrategies
      ImportQualifiedPost
      LambdaCase
      NumericUnderscores
      OverloadedStrings
      QuasiQuotes
      RecordWildCards
      StrictData
      TypeApplications

--------------------------------------------------------------------------------

library
  import: common-extensions
  build-depends:
      aeson
    , base
    , bytestring
    , crypton-x509
    , crypton-x509-store
    , http-client
    , http-conduit
    , jose               >= 0.11 && < 0.12
    , string-interpolate
    , text
    , time
    , transformers
  exposed-modules:
    Google.ServiceAccount
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Werror -fwrite-ide-info

--------------------------------------------------------------------------------

test-suite google-service-account-test
  import: common-extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Google.ServiceAccountSpec
  default-language: Haskell2010
  build-depends:
      aeson
    , base >= 4.19 && < 5
    , google-service-account
    , hspec
    , http-client
    , text
    , time
  build-tool-depends:
      hspec-discover:hspec-discover
  ghc-options: -Wall -Werror -fwrite-ide-info
