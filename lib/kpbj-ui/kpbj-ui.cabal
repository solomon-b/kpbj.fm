cabal-version:      3.0
name:               kpbj-ui
version:            0.1.0.0
synopsis:           KPBJ UI: design tokens, themes, components, and the form builder
description:
    The design system of KPBJ, in three layers: Design < Component <
    Lucid.Form.Builder. A layer imports only from the layers below it.
    The package depends on no other KPBJ package except lucid-htmx-alpine
    and lucid-tailwind.
license:            Apache-2.0
author:             Solomon Bothwell
maintainer:         ssbothwell@gmail.com
build-type:         Simple
extra-source-files:
    static/forms.css

library
  default-language: Haskell2010
  default-extensions:
      DataKinds
      DeriveGeneric
      DerivingStrategies
      FlexibleContexts
      FlexibleInstances
      GADTs
      ImportQualifiedPost
      LambdaCase
      OverloadedStrings
      QuasiQuotes
      RecordWildCards
      StrictData
  build-depends:
      base >=4.14 && <5
    , aeson
    , bytestring
    , file-embed
    , lens
    , lucid2
    , lucid-htmx-alpine
    , lucid-tailwind
    , mtl
    , string-interpolate
    , text
  exposed-modules:
      Component.Banner
    , Component.Button
    , Component.Choice
    , Component.Field
    , Component.InfiniteScroll
    , Component.Input
    , Component.PageHeader
    , Component.SourceTypeBadge
    , Component.Table
    , Component.Tailwind
    , Design
    , Design.FormStyles
    , Design.StyleBuilder
    , Design.Theme
    , Design.Tokens
    , Lucid.Form.Builder
    , Lucid.Form.Builder.Types
    , Lucid.Form.Builder.Core
    , Lucid.Form.Builder.Field
    , Lucid.Form.Builder.Render
    , Lucid.Form.Builder.Alpine
    , Lucid.Form.Builder.JS
  hs-source-dirs: src
  ghc-options: -Wall -Werror -fwrite-ide-info

test-suite kpbj-ui-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Component.ButtonSpec
    Component.ChoiceSpec
    Component.FieldSpec
    Component.InputSpec
    Component.TailwindSpec
    Design.ThemeSpec
    Lucid.Form.Builder.RenderSpec
    Test.Classes
  default-language: Haskell2010
  default-extensions:
      ImportQualifiedPost
      OverloadedStrings
  build-depends:
      base
    , hspec
    , kpbj-ui
    , lens
    , lucid2
    , text
  build-tool-depends:
      hspec-discover:hspec-discover
  ghc-options: -Wall -Werror -fwrite-ide-info
