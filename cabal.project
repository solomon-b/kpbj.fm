-- Root cabal.project for the kpbj.fm monorepo
-- All services are built from here
--
-- This file has no source-repository-package pins. The nix dev shell supplies
-- every dependency, and cabal uses those packages. flake.nix sets the version
-- of each dependency that nixpkgs does not supply.

packages:
  services/web/kpbj-web.cabal
  lib/lucid-form-builder/lucid-form-builder.cabal
  lib/lucid-htmx-alpine/lucid-htmx-alpine.cabal
  lib/lucid-tailwind/lucid-tailwind.cabal
  lib/kpbj-types/kpbj-types.cabal
  lib/kpbj-storage/kpbj-storage.cabal
  lib/kpbj-database/kpbj-database.cabal
  lib/kpbj-email/kpbj-email.cabal
  lib/kpbj-job/kpbj-job.cabal
  lib/stripe-http/stripe-http.cabal
  lib/easypost-http/easypost-http.cabal
  lib/mailchimp-http/mailchimp-http.cabal
  lib/google-service-account/google-service-account.cabal
  jobs/sync-host-emails/sync-host-emails.cabal
  jobs/sync-schedule-calendar/sync-schedule-calendar.cabal
  jobs/token-cleanup/token-cleanup.cabal
  jobs/episode-check/episode-check.cabal
  jobs/listener-snapshots/listener-snapshots.cabal
  jobs/ga-poller/ga-poller.cabal
  jobs/mailchimp-reconcile/mailchimp-reconcile.cabal
  jobs/order-cleanup/order-cleanup.cabal
  jobs/staged-upload-cleanup/staged-upload-cleanup.cabal
