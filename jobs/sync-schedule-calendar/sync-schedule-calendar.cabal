cabal-version:      3.0
name:               sync-schedule-calendar
version:            0.1.0
license:            Apache-2.0
author:             Solomon Bothwell
maintainer:         ssbothwell@gmail.com
build-type:         Simple

common extensions
  default-language: Haskell2010
  default-extensions:
      BlockArguments
      DerivingStrategies
      ImportQualifiedPost
      LambdaCase
      NumericUnderscores
      OverloadedStrings
      QuasiQuotes
      RecordWildCards
      StrictData
      TypeApplications

library
  import:           extensions
  exposed-modules:  Event
                  , GoogleCalendar
                  , Rrule
                  , Series
                  , Sync
  build-depends:    base
                  , aeson
                  , bytestring
                  , containers
                  , crypton-x509
                  , crypton-x509-store
                  , http-client
                  , http-conduit
                  , http-types
                  , jose               >= 0.11 && < 0.12
                  , string-interpolate
                  , transformers
                  , kpbj-database
                  , kpbj-types
                  , text
                  , text-display
                  , time
  hs-source-dirs:   src
  ghc-options:      -Wall -fwrite-ide-info

executable sync-schedule-calendar
  import:           extensions
  main-is:          Main.hs
  build-depends:    base
                  , aeson
                  , bytestring
                  , kpbj-database
                  , kpbj-job
                  , kpbj-types
                  , log-base
                  , optparse-applicative
                  , sync-schedule-calendar
                  , text
                  , time
                  , web-server-core
  hs-source-dirs:   .
  ghc-options:      -Wall -threaded -fwrite-ide-info

test-suite sync-schedule-calendar-spec
  import:             extensions
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  other-modules:      EventSpec
                    , Gen
                    , GoogleCalendarSpec
                    , RruleSpec
                    , SeriesSpec
                    , SyncSpec
  hs-source-dirs:     test
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:      base
                    , aeson
                    , containers
                    , mtl
                    , hedgehog
                    , hspec
                    , hspec-hedgehog
                    , http-client
                    , kpbj-database
                    , kpbj-types
                    , sync-schedule-calendar
                    , text
                    , time
  ghc-options:        -Wall -fwrite-ide-info
